{
  "expo": {
    "name": "MyWallet",
    "slug": "mywallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet and authorize transactions.",
        "NSCameraUsageDescription": "Used to scan QR codes for wallet addresses."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan QR codes for wallet addresses."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E17"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
